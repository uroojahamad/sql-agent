# Pooled Neon connection used by the application at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/sql-agent?sslmode=require"

# Direct Neon connection used by Prisma migrations and schema commands.
DIRECT_URL="postgresql://USER:PASSWORD@ENDPOINT.REGION.aws.neon.tech/sql-agent?sslmode=require"

# Existing model provider key used by the chat route.
GOOGLE_GENERATIVE_AI_API_KEY=""

# Server-only Upstash Redis credentials used by API rate limiting.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional overrides. Production defaults are 10 requests/minute and 50/day.
CHAT_RATE_LIMIT_BURST_MAX="10"
CHAT_RATE_LIMIT_DAILY_MAX="50"
